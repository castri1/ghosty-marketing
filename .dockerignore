# keep the build context minimal — only app source reaches `COPY . .`
node_modules
.next
out
.git
.github

# env files — Next's standalone output copies .env/.env.production into the
# runtime bundle, so none of them may enter the build context (the image
# needs no env at build time by design)
.env*
.DS_Store
*.tsbuildinfo
*.log

# not needed inside the image
Dockerfile
.dockerignore
README.md
CLAUDE.md

# google-github-actions/auth writes its credentials file into the workspace
# during CI — it must NEVER enter the build context (same pitfall encoded in
# the ghosty monorepo's root .dockerignore).
gha-creds-*.json
